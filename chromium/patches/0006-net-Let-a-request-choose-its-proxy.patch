   return session_->proxy_resolution_service()->ResolveProxy(
diff --git a/net/url_request/url_request.h b/net/url_request/url_request.h
index 4967f032f2..f387caaaf8 100644
--- a/net/url_request/url_request.h
+++ b/net/url_request/url_request.h
@@ -812,6 +812,17 @@ class NET_EXPORT URLRequest : public base::SupportsUserData {
   // general response_info() is available.
   const ProxyChain& proxy_chain() const { return proxy_chain_; }
 
+  // crnet: the proxy chain to use instead of resolving one with the
+  // context's proxy configuration (ProxyChain::Direct() for none), or
+  // nullopt to resolve it as usual. Set it before Start(); it applies to
+  // every redirect of the request.
+  void set_proxy_chain_override(std::optional<ProxyChain> proxy_chain) {
+    proxy_chain_override_ = std::move(proxy_chain);
+  }
+  const std::optional<ProxyChain>& proxy_chain_override() const {
+    return proxy_chain_override_;
+  }
+
   // Gets the connection attempts made in the process of servicing this
   // URLRequest. Only guaranteed to be valid if called after the request fails
   // or after the response headers are received.
@@ -1262,6 +1273,9 @@ class NET_EXPORT URLRequest : public base::SupportsUserData {
   // The proxy chain used for this request, if any.
   ProxyChain proxy_chain_;
 
+  // crnet: see set_proxy_chain_override().
+  std::optional<ProxyChain> proxy_chain_override_;
+
   // If not null, the network service will not advertise any stream types
   // (via Accept-Encoding) that are not listed. Also, it will not attempt
   // decoding any non-listed stream types.
