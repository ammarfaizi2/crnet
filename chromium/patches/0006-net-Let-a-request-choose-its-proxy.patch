net: Let a request choose its proxy

A URLRequestContext resolves every request's proxy from one proxy
configuration. ProxyDelegate::OnResolveProxy() can change the result,
but it only sees the URL, the method and the network anonymization
key, so it cannot tell two requests to the same URL apart. An embedder
that spreads requests over several proxies needs a context per proxy,
each with its own connection pools, host cache and cookie store.

Let the request carry the proxy chain instead:
URLRequest::set_proxy_chain_override() is copied into HttpRequestInfo
and on into HttpStreamFactory::StreamRequestInfo, and the JobController
uses it in place of resolving one, next to the existing
LOAD_BYPASS_PROXY shortcut. It has no fallbacks.
Connection pools, HTTP/2 and QUIC sessions are keyed by proxy chain
already, so requests through different proxies never share a
connection.

diff --git a/net/http/http_request_info.h b/net/http/http_request_info.h
index f611ce56c4..7f0d1de746 100644
--- a/net/http/http_request_info.h
+++ b/net/http/http_request_info.h
@@ -16,6 +16,7 @@
 #include "net/base/network_handle.h"
 #include "net/base/network_isolation_key.h"
 #include "net/base/privacy_mode.h"
+#include "net/base/proxy_chain.h"
 #include "net/base/reconnect_notifier.h"
 #include "net/base/request_priority.h"
 #include "net/dns/public/secure_dns_policy.h"
@@ -72,6 +73,10 @@ struct NET_EXPORT HttpRequestInfo {
   // Any load flags (see load_flags.h).
   int load_flags = 0;
 
+  // crnet: the proxy chain to use instead of resolving one, if set (see
+  // URLRequest::set_proxy_chain_override()).
+  std::optional<ProxyChain> proxy_chain_override;
+
   // Flag that indicates if the request should be loaded concurrently with
