diff --git a/net/http/http_stream_factory_job_controller.cc b/net/http/http_stream_factory_job_controller.cc
index 11361641d5..0d5ca2ceae 100644
--- a/net/http/http_stream_factory_job_controller.cc
+++ b/net/http/http_stream_factory_job_controller.cc
@@ -842,6 +842,13 @@ int HttpStreamFactory::JobController::DoResolveProxy() {
     return OK;
   }
 
+  // crnet: a proxy chosen for this request replaces the configured ones,
+  // without fallbacks.
+  if (request_info_.proxy_chain_override) {
+    proxy_info_.UseProxyChain(*request_info_.proxy_chain_override);
+    return OK;
+  }
+
   CompletionOnceCallback io_callback =
