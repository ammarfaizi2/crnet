 static constexpr std::array<uint8_t, 3> kSOCKS5GreetWriteData{
     0x05, 0x01, 0x00};  // no authentication
+// crnet: no authentication, or username/password.
+static constexpr std::array<uint8_t, 4> kSOCKS5GreetWriteDataWithAuth{
+    0x05, 0x02, 0x00, 0x02};
+
+namespace {
+std::atomic<SOCKS5ClientSocket::CredentialsLookup> g_credentials_lookup{
+    nullptr};
+}  // namespace
+
+// static
+void SOCKS5ClientSocket::SetCredentialsLookup(CredentialsLookup lookup) {
+  g_credentials_lookup.store(lookup);
+}
+
+void SOCKS5ClientSocket::SetCredentials(std::string username,
+                                        std::string password) {
+  credentials_.emplace(std::move(username), std::move(password));
+}
+
+void SOCKS5ClientSocket::LookUpCredentials(const HostPortPair& proxy) {
+  CredentialsLookup lookup = g_credentials_lookup.load();
+  std::string username, password;
+  if (lookup && lookup(proxy, &username, &password)) {
+    SetCredentials(std::move(username), std::move(password));
+  }
+}
 
