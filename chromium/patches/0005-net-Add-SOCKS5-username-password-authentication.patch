+
+// crnet: RFC 1929 username/password sub-negotiation.
+int SOCKS5ClientSocket::DoAuthWrite() {
+  if (!write_buf_) {
+    const auto& [username, password] = *credentials_;
+    if (username.empty() || username.size() > 0xFF || password.empty() ||
+        password.size() > 0xFF) {
+      return ERR_SOCKS_CONNECTION_FAILED;
+    }
+    std::vector<uint8_t> auth;
+    auth.push_back(0x01);  // sub-negotiation version
+    auth.push_back(base::checked_cast<uint8_t>(username.size()));
+    auth.insert(auth.end(), username.begin(), username.end());
+    auth.push_back(base::checked_cast<uint8_t>(password.size()));
+    auth.insert(auth.end(), password.begin(), password.end());
+    auto buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(auth));
+    write_buf_ = base::MakeRefCounted<DrainableIOBuffer>(std::move(buffer),
+                                                         buffer->size());
+  }
+  next_state_ = STATE_AUTH_WRITE_COMPLETE;
+  return transport_socket_->Write(write_buf_.get(),
+                                  write_buf_->BytesRemaining(), io_callback_,
+                                  traffic_annotation_);
+}
+
+int SOCKS5ClientSocket::DoAuthWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  write_buf_->DidConsume(result);
+  if (write_buf_->BytesRemaining() == 0) {
+    write_buf_.reset();
+    next_state_ = STATE_AUTH_READ;
+  } else {
+    next_state_ = STATE_AUTH_WRITE;
+  }
+  return OK;
+}
+
+int SOCKS5ClientSocket::DoAuthRead() {
+  next_state_ = STATE_AUTH_READ_COMPLETE;
+  if (!read_buf_) {
+    read_buf_ = base::MakeRefCounted<GrowableIOBuffer>();
+    read_buf_->SetCapacity(2);  // version, status
+  }
+  return transport_socket_->Read(read_buf_.get(),
+                                 read_buf_->RemainingCapacity(), io_callback_);
+}
+
+int SOCKS5ClientSocket::DoAuthReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    return ERR_CONNECTION_CLOSED;
+  }
+  read_buf_->set_offset(read_buf_->offset() + result);
+  if (read_buf_->RemainingCapacity() > 0) {
+    next_state_ = STATE_AUTH_READ;
+    return OK;
+  }
+  base::span<uint8_t> read_data = read_buf_->span_before_offset();
+  if (read_data[0] != 0x01) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  if (read_data[1] != 0x00) {
+    return ERR_SOCKS_AUTH_FAILED;
+  }
+  read_buf_.reset();
+  next_state_ = STATE_HANDSHAKE_WRITE;
+  return OK;
 }
 
