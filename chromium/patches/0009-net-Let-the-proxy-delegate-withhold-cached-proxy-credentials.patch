net: Let the proxy delegate withhold cached proxy credentials

The proxy auth cache sends the credentials it learned for a proxy with
every later request to it, up front. An embedder that reaches one proxy
under several identities can replace them through the proxy delegate's
headers (OnBeforeTunnelRequest() and, with the previous patch,
OnBeforeHttpRequestToProxy()), but cannot make a request go without
any: one meant to carry no identity would still carry the cached one.

Let an empty Proxy-Authorization header from the delegate remove the
cache's, for tunnels and for plain requests to the proxy.

diff --git a/net/base/proxy_delegate.h b/net/base/proxy_delegate.h
--- a/net/base/proxy_delegate.h
+++ b/net/base/proxy_delegate.h
@@ -122,6 +122,10 @@
   // tunnel (an http:// URL), like OnBeforeTunnelRequest() for a tunnel:
   // headers added to `headers` go to the proxy, replacing those of the
   // proxy auth cache.
+  //
+  // crnet: for both, an empty Proxy-Authorization header removes the one
+  // the proxy auth cache would send, so that a request can go without
+  // credentials the cache knows for the proxy.
   virtual void OnBeforeHttpRequestToProxy(const ProxyChain& proxy_chain,
                                           HttpRequestHeaders* headers) {}
 };
diff --git a/net/http/http_network_transaction.cc b/net/http/http_network_transaction.cc
--- a/net/http/http_network_transaction.cc
+++ b/net/http/http_network_transaction.cc
@@ -1441,6 +1441,10 @@
     session_->context().proxy_delegate->OnBeforeHttpRequestToProxy(
         proxy_info_.proxy_chain(), &proxy_headers);
     request_headers_.MergeFrom(proxy_headers);
+    if (request_headers_.GetHeader(HttpRequestHeaders::kProxyAuthorization) ==
+        "") {
+      request_headers_.RemoveHeader(HttpRequestHeaders::kProxyAuthorization);
+    }
   }
   if (ShouldApplyServerAuth() && HaveAuth(HttpAuth::AUTH_SERVER))
     auth_controllers_[HttpAuth::AUTH_SERVER]->AddAuthorizationHeader(
diff --git a/net/http/http_proxy_client_socket.cc b/net/http/http_proxy_client_socket.cc
index 2b864b051f..74fe87c3bb 100644
--- a/net/http/http_proxy_client_socket.cc
+++ b/net/http/http_proxy_client_socket.cc
@@ -422,6 +422,11 @@ int HttpProxyClientSocket::DoSendRequest() {
     HttpRequestHeaders extra_headers;
     extra_headers.MergeFrom(authorization_headers_);
     extra_headers.MergeFrom(proxy_delegate_headers_);
+    // crnet: an empty one from the delegate withholds the cache's.
+    if (extra_headers.GetHeader(HttpRequestHeaders::kProxyAuthorization) ==
+        "") {
+      extra_headers.RemoveHeader(HttpRequestHeaders::kProxyAuthorization);
+    }
 
     BuildTunnelRequest(endpoint_, extra_headers, user_agent_, &request_line_,
                        &request_headers_);
