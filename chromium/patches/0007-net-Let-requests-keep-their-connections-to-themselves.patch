+void HttpNetworkSession::CloseConnectionPartition(int partition) {
+  spdy_session_pool_.CloseIdleSessionsInPartition(partition);
+  quic_session_pool_.CloseIdleSessionsInPartition(partition);
+  normal_socket_pool_manager_->CloseConnectionPartition(partition);
+  websocket_socket_pool_manager_->CloseConnectionPartition(partition);
+}
