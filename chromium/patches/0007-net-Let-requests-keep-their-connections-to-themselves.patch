+void ClientSocketPoolManagerImpl::CloseConnectionPartition(int partition) {
+  for (auto it = socket_pools_.begin(); it != socket_pools_.end();) {
+    std::optional<int> pool_partition = it->first.opaque_data();
+    if (pool_partition == partition) {
+      it->second->CloseIdleSockets("Connection partition closed");
+    }
+    // Each partition gets pools of its own; without this they would pile
+    // up for as long as the session lives.
+    if (pool_partition && it->second->IsUnused()) {
+      it = socket_pools_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
