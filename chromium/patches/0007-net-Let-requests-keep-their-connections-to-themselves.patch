+void QuicSessionPool::CloseIdleSessionsInPartition(int partition) {
+  // Closing a session removes it from all_sessions_.
+  std::vector<QuicChromiumClientSession*> idle;
+  for (const auto& session : all_sessions_) {
+    if (session->quic_session_key().proxy_chain().opaque_data() ==
+            partition &&
+        session->GetNumActiveStreams() == 0) {
+      idle.push_back(session.get());
+    }
+  }
+  for (QuicChromiumClientSession* session : idle) {
+    session->CloseSessionOnError(
+        ERR_ABORTED, quic::QUIC_CONNECTION_CANCELLED,
+        quic::ConnectionCloseBehavior::SEND_CONNECTION_CLOSE_PACKET);
+  }
+}
