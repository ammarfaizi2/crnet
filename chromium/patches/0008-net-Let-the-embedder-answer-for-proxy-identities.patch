     }
     socket_ = std::move(socks5_socket);
   } else {
diff --git a/net/socket/socks_connect_job.h b/net/socket/socks_connect_job.h
index 3fc7dc02d6..e17ff6727e 100644
--- a/net/socket/socks_connect_job.h
+++ b/net/socket/socks_connect_job.h
@@ -6,6 +6,7 @@
 #define NET_SOCKET_SOCKS_CONNECT_JOB_H_
 
 #include <memory>
+#include <optional>
 
 #include "base/memory/raw_ptr.h"
 #include "base/memory/ref_counted.h"
@@ -52,6 +53,15 @@ class NET_EXPORT_PRIVATE SOCKSSocketParams
     return traffic_annotation_;
   }
 
+  // crnet: the opaque data of the proxy chain the connection is for, for
+  // SOCKS5ClientSocket::LookUpCredentials().
+  void set_proxy_chain_opaque_data(std::optional<int> data) {
+    proxy_chain_opaque_data_ = data;
+  }
+  std::optional<int> proxy_chain_opaque_data() const {
+    return proxy_chain_opaque_data_;
+  }
+
  private:
   friend class base::RefCounted<SOCKSSocketParams>;
   ~SOCKSSocketParams();
@@ -64,6 +74,7 @@ class NET_EXPORT_PRIVATE SOCKSSocketParams
   const NetworkAnonymizationKey network_anonymization_key_;
 
   NetworkTrafficAnnotationTag traffic_annotation_;
+  std::optional<int> proxy_chain_opaque_data_;
 };
 
