@PACKAGE_INIT@

if(NOT TARGET crhttp::crhttp)
  add_library(crhttp::crhttp SHARED IMPORTED)
  set_target_properties(crhttp::crhttp PROPERTIES
    IMPORTED_LOCATION "@PACKAGE_CMAKE_INSTALL_LIBDIR@/libcrhttp.so.@PROJECT_VERSION@"
    IMPORTED_SONAME "libcrhttp.so.@CRHTTP_SOVERSION@"
    INTERFACE_INCLUDE_DIRECTORIES "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
endif()

check_required_components(crhttp)
