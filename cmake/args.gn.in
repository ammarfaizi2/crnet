# Generated by CMake from cmake/args.gn.in. Edits are overwritten.
crnet_root = "@CRNET_SOURCE_ROOT@"
root_extra_deps = [ "//crnet" ]

is_debug = @CRNET_GN_IS_DEBUG@
is_asan = @CRNET_GN_IS_ASAN@
is_tsan = @CRNET_GN_IS_TSAN@
is_component_build = false
is_official_build = false
dcheck_always_on = false
symbol_level = 1
blink_symbol_level = 0
v8_symbol_level = 0
chrome_pgo_phase = 0
treat_warnings_as_errors = true

# A library must not replace the host process' malloc.
use_allocator_shim = false
use_partition_alloc_as_malloc = false
enable_backup_ref_ptr_support = false

# Embed ICU data instead of shipping icudtl.dat next to the .so.
icu_use_data_file = false

@CRNET_GN_EXTRA_ARGS_NL@
