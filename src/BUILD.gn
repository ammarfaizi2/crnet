#
# libcrnet.so, built inside the Chromium tree as //crnet (this
# directory is symlinked to chromium/src/crnet by
# scripts/fetch-chromium.sh). Driven by the top-level CMakeLists.txt.

declare_args() {
  # Absolute path of the crnet source tree (for include/crnet/*.h).
  crnet_root = ""
}

assert(crnet_root != "", "crnet_root must be set in args.gn")

_cr_version = read_file("//chrome/VERSION", "scope")
_cr_version_string = "${_cr_version.MAJOR}.${_cr_version.MINOR}." +
                     "${_cr_version.BUILD}.${_cr_version.PATCH}"

config("crnet_config") {
  include_dirs = [ "$crnet_root/include" ]
  defines = [
    "CRNET_CHROMIUM_VERSION=\"$_cr_version_string\"",
    "CRNET_CHROMIUM_MAJOR=${_cr_version.MAJOR}",
  ]
}

shared_library("crnet") {
  output_name = "crnet"
  output_extension = "so"

  sources = [
    "$crnet_root/include/crnet/crnet.h",
    "api.cc",
    "client.cc",
    "global.cc",
    "internal.h",
    "profile.cc",
    "queue.cc",
    "transfer.cc",
    "websocket.cc",
    "websocket.h",
  ]

  configs += [ ":crnet_config" ]

  # crnet is not Chromium first-party code: skip the Chromium-only
  # clang plugin rules (raw_ptr<T> etc.).
  configs -= [ "//build/config/clang:find_bad_constructs" ]

  deps = [
    "//base",
    "//base:i18n",
    "//components/network_session_configurator/browser",
    "//net",
    "//url",
  ]

  inputs = [ "crnet.map" ]
  ldflags = [
    "-Wl,--version-script=" + rebase_path("crnet.map", root_build_dir),
    "-Wl,-soname,libcrnet.so.0",
    "-Wl,-z,defs",
  ]
}
